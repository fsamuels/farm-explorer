# Raw drone captures — large, keep out of git until an LFS/storage decision is made
assets/drone-source/

# Ground-level reference photos for wall texturing — will accumulate across every
# building as texturing continues, so treated the same as drone-source rather than
# committed. The elevation-rectifier tool (tools/elevation-rectifier.html) never
# uploads these raw photos anyway, only the rectified crop it produces, so nothing
# in the texturing workflow actually needs them tracked in git.
assets/reference-photos/

# OS
.DS_Store
Thumbs.db

# Godot (if selected)
.godot/
*.import

# Exported builds (Web export lands here per project/export_presets.cfg) —
# regenerated from source, not tracked
builds/

# tr6.glb and bmw_2002_tii.glb embed their textures instead of extracting them
# (unlike other models), so their .import settings must be tracked or a fresh
# reimport falls back to the default Extract mode and breaks the scene again.
!project/models/tr6.glb.import
!project/models/bmw_2002_tii.glb.import

# Unity (if selected)
Library/
Temp/
Obj/
Build/
Logs/
*.csproj
*.sln
