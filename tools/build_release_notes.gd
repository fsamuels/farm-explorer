extends SceneTree
## Regenerates project/scripts/release_data.gd (the data behind the What's New
## dialog, D-130) from CHANGELOG.md and a count of the game. Run it from
## project/ after editing CHANGELOG.md, and commit the result:
##   godot --headless -s ../tools/build_release_notes.gd

const ReleaseNotes := preload("res://scripts/release_notes.gd")

func _init() -> void:
	var project_dir := ProjectSettings.globalize_path("res://").trim_suffix("/")
	var repo := project_dir.path_join("..").simplify_path()
	var entries := ReleaseNotes.parse(FileAccess.get_file_as_string(repo.path_join("CHANGELOG.md")))
	var problems := ReleaseNotes.problems(entries)
	if not problems.is_empty():
		for p in problems:
			printerr("CHANGELOG.md: " + p)
		quit(1)
		return
	var data := {"entries": entries, "stats": ReleaseNotes.collect_stats(project_dir)}
	var out := FileAccess.open("res://scripts/release_data.gd", FileAccess.WRITE)
	if out == null:
		printerr("cannot write release_data.gd (run from project/): error %d" % FileAccess.get_open_error())
		quit(1)
		return
	out.store_string("# Generated by tools/build_release_notes.gd from CHANGELOG.md. Do not edit by hand;\n"
			+ "# edit CHANGELOG.md and run: cd project && godot --headless -s ../tools/build_release_notes.gd\n"
			+ "extends RefCounted\n\nconst DATA := " + JSON.stringify(data, "\t") + "\n")
	out.close()
	print("release_data.gd: %d releases, %d lines of code" % [entries.size(), data.stats.code_lines])
	quit()
