extends Node3D
## The land beyond the farm (D-133): real USGS terrain out to 80 km all round,
## with the Blue Mountains 35-65 km to the east and the wind-farm ridges 9-23 km
## to the south-west and west, plus every wind turbine in the US Wind Turbine
## Database within that radius at its real position, spinning, with red warning
## lights that flash at night.
##
## Built at start-up from horizon_data.gd (generated by
## tools/build_horizon_data.py) through horizon_math.gd, which has the
## exaggeration, curvature and distance-squeezing rules. The shaders draw it
## at true bearing and distance, so it moves against the farm as you walk, but
## inside the camera's far plane; and with their own distance haze, because
## the scene fog would hide anything this far away.
##
## `season` picks summer or winter colours (the G sky menu's Season button). The
## snow weathers show winter whatever the season.

const HorizonMath := preload("res://scripts/horizon_math.gd")
const HorizonData := preload("res://scripts/horizon_data.gd")
const WorldData := preload("res://scripts/world_data.gd")
const WorldMath := preload("res://scripts/world_math.gd")
const Weather := preload("res://scripts/weather.gd")
const TERRAIN_SHADER := preload("res://shaders/distant_terrain.gdshader")
const TURBINE_SHADER := preload("res://shaders/wind_turbine.gdshader")

const SEASONS := ["summer", "winter"]
## Rings out to this distance (m) use the world's own heights (use_world_heights).
const WORLD_RINGS_MAX := 5400.0
## The wind here mostly blows from the south-west, so rotors face that way.
const WIND_FROM_BEARING := 235.0
## Share of turbines carrying a red warning light (the FAA lights a farm's
## outline and every so often inside it, not every turbine).
const BEACON_SHARE := 0.35
## Share of turbines standing still (maintenance, curtailment).
const IDLE_SHARE := 0.06
## Thinnest a tower or blade is drawn, as a fraction of its distance (about a
## pixel wide at 1080p), so far turbines don't break up into flicker.
const MIN_WIDTH_PER_METRE := 1.2e-3
## Towers are sunk this far (before exaggeration) so they never float over
## the coarse terrain facets.
const TOWER_SINK := 12.0
## Where the warning light sits on the nacelle mesh (a 2.4 m cube; its base,
## 1.2 m lower, is wind_turbine.gdshader's BEACON_BASE, which it grows from).
const BEACON_CENTER := Vector3(0.0, 3.2, -4.0)

@export var time_of_day_path: NodePath = ^"../TimeOfDay"
@export var weather_path: NodePath = ^"../Weather"
@export var season := "winter"

var _tod: Node
var _weather: Node
var _terrain_material: ShaderMaterial
var _tower_material: ShaderMaterial
var _rotor_material: ShaderMaterial
var _heights: PackedFloat32Array
var terrain: MeshInstance3D
var towers: MultiMeshInstance3D
var heads: MultiMeshInstance3D
var rotors: MultiMeshInstance3D

func _ready() -> void:
	_tod = get_node_or_null(time_of_day_path)
	_weather = get_node_or_null(weather_path)
	_heights = HorizonMath.decode_heights(HorizonData.HEIGHTS_B64)
	use_world_heights(_heights)
	_terrain_material = ShaderMaterial.new()
	_terrain_material.shader = TERRAIN_SHADER
	_tower_material = ShaderMaterial.new()
	_tower_material.shader = TURBINE_SHADER
	_rotor_material = ShaderMaterial.new()
	_rotor_material.shader = TURBINE_SHADER
	_rotor_material.set_shader_parameter("spin", true)
	terrain = _instance(MeshInstance3D.new(), "Terrain") as MeshInstance3D
	terrain.mesh = build_terrain_mesh(_heights)
	terrain.material_override = _terrain_material
	_build_turbines()
	if _tod and _tod.has_signal("lighting_changed"):
		_tod.lighting_changed.connect(_on_lighting_changed)
		if _tod.has_method("shown"):
			var p: Dictionary = _tod.shown()
			if not p.is_empty():
				_on_lighting_changed(p)
	_apply_season()

## Inside the driveable world (D-146) the coarse land follows the same 20 m ground
## the world is built from, rather than the polar grid's blend of mean and
## highest, so the two meet without a step where the fine ground ends. Rings
## beyond WORLD_RINGS_MAX keep the original data.
static func use_world_heights(heights: PackedFloat32Array) -> void:
	for i in HorizonData.RINGS.size():
		var r: float = HorizonData.RINGS[i]
		if r > WORLD_RINGS_MAX:
			break
		for j in HorizonData.COLUMNS:
			var xz := HorizonMath.polar_point(j * HorizonData.BEARING_STEP, r)
			if absf(xz.x) > WorldData.HALF - 100.0 or absf(xz.y) > WorldData.HALF - 100.0:
				continue
			heights[i * HorizonData.COLUMNS + j] = WorldData.ORIGIN_ELEVATION + WorldMath.raw_height(xz.x, xz.y)

## Summer or winter colours on the mountains and fields.
func set_season(season_name: String) -> void:
	if not SEASONS.has(season_name):
		push_warning("Unknown season '%s'" % season_name)
		return
	season = season_name
	_apply_season()

## 0 = summer colours .. 1 = winter: winter, or snow falling whatever the season.
func snow_amount() -> float:
	return 1.0 if season == "winter" or _snowing() else 0.0

func _snowing() -> bool:
	if _weather == null:
		return false
	var w: Dictionary = Weather.WEATHER.get(_weather.current, {})
	return w.get("precip", "") == "snow"

func _apply_season() -> void:
	if _terrain_material:
		_terrain_material.set_shader_parameter("snow", snow_amount())

func _on_lighting_changed(p: Dictionary) -> void:
	var per_metre := HorizonMath.haze_per_metre(
		_tod.overcast if _tod else 0.0,
		_tod.fog_extra if _tod else 0.0,
		_tod.smoke_level if _tod else 0.0,
		_snowing())
	var sky: Color = p.get("sky_color", Color(0.55, 0.75, 0.95))
	for m in [_terrain_material, _tower_material, _rotor_material]:
		m.set_shader_parameter("haze_color", sky)
		m.set_shader_parameter("haze_per_metre", per_metre)
	var dark := HorizonMath.darkness(sky)
	_tower_material.set_shader_parameter("darkness", dark)
	_apply_season()  # weather changes come through here too

func _instance(node: GeometryInstance3D, node_name: String) -> GeometryInstance3D:
	node.name = node_name
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	# Drawn squeezed in around the camera, nowhere near the mesh's real
	# bounds, so culling has to go by where it ends up instead.
	node.custom_aabb = AABB(Vector3(-4500, -300, -4500), Vector3(9000, 1200, 9000))
	add_child(node)
	return node

## Scene position of grid point (ring `i`, column `j`).
static func grid_point(heights: PackedFloat32Array, i: int, j: int) -> Vector3:
	var r: float = HorizonData.RINGS[i]
	var xz := HorizonMath.polar_point(j * HorizonData.BEARING_STEP, r)
	var e := heights[i * HorizonData.COLUMNS + j]
	return Vector3(xz.x, HorizonMath.scene_height(e, r), xz.y)

## The terrain as flat-shaded triangles (every facet its own vertices, normal
## and colour). COLOR.r is the facet's real elevation / 2500 m, COLOR.g a
## 0..1 patch value per facet (smooth noise plus a little jitter), both read by distant_terrain.gdshader.
static func build_terrain_mesh(heights: PackedFloat32Array) -> ArrayMesh:
	var rings: int = HorizonData.RINGS.size()
	var cols: int = HorizonData.COLUMNS
	# Patches (fields, snow line, forest edges) come from smooth noise so
	# neighbouring facets agree, with a little per-facet jitter on top.
	var noise := FastNoiseLite.new()
	noise.seed = 131
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	noise.frequency = 1.0 / 1400.0
	noise.fractal_octaves = 3
	var points := PackedVector3Array()
	points.resize(rings * cols)
	for i in rings:
		for j in cols:
			points[i * cols + j] = grid_point(heights, i, j)
	var tri_count := (rings - 1) * cols * 2
	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	verts.resize(tri_count * 3)
	normals.resize(tri_count * 3)
	colors.resize(tri_count * 3)
	var k := 0
	for i in rings - 1:
		for j in cols:
			var j1 := (j + 1) % cols
			var a := i * cols + j
			var b := i * cols + j1
			var c := (i + 1) * cols + j
			var d := (i + 1) * cols + j1
			for tri in [[a, c, b], [b, c, d]]:
				var p0 := points[tri[0]]
				var p1 := points[tri[1]]
				var p2 := points[tri[2]]
				var n := (p2 - p0).cross(p1 - p0).normalized()
				if n.y < 0.0:
					# Keep every facet front-facing (clockwise) from above.
					var swap := p1
					p1 = p2
					p2 = swap
					n = -n
				var elev := (heights[tri[0]] + heights[tri[1]] + heights[tri[2]]) / 3.0
				var centre := (p0 + p1 + p2) / 3.0
				var jitter := _hash(i * 7919 + j * 31 + (0 if tri[0] == a else 1)) - 0.5
				var rnd := clampf(0.5 + 0.75 * noise.get_noise_2d(centre.x, centre.z) + 0.2 * jitter, 0.0, 1.0)
				var col := Color(clampf(elev / 2500.0, 0.0, 1.0), rnd, 0.0, 1.0)
				verts[k] = p0
				verts[k + 1] = p1
				verts[k + 2] = p2
				for m in 3:
					normals[k + m] = n
					colors[k + m] = col
				k += 3
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh

## A repeatable 0..1 value from an integer.
static func _hash(n: int) -> float:
	var x := (n * 1103515245 + 12345) & 0x7fffffff
	x = (x ^ (x >> 13)) * 1274126177 & 0x7fffffff
	return float(x % 10007) / 10006.0

## Where turbine `t` (a HorizonData.TURBINES row) stands: its scene base
## position on the drawn terrain, and how much it is scaled (the terrain's
## exaggeration where it stands, so it keeps its size against the hill).
static func turbine_base(heights: PackedFloat32Array, t: Array) -> Dictionary:
	var x: float = t[0]
	var z: float = t[1]
	var r := Vector2(x, z).length()
	var e := HorizonMath.elevation_at(heights, HorizonData.RINGS, HorizonData.COLUMNS, x, z)
	return {"position": Vector3(x, HorizonMath.scene_height(e, r), z), "scale": HorizonMath.exaggeration(r), "distance": r}

func _build_turbines() -> void:
	var list: Array = HorizonData.TURBINES
	var n := list.size()
	towers = _instance(MultiMeshInstance3D.new(), "TurbineTowers") as MultiMeshInstance3D
	heads = _instance(MultiMeshInstance3D.new(), "TurbineHeads") as MultiMeshInstance3D
	rotors = _instance(MultiMeshInstance3D.new(), "TurbineRotors") as MultiMeshInstance3D
	var meshes := [_tower_mesh(), _head_mesh(), _rotor_mesh()]
	var mms: Array[MultiMesh] = []
	for node: MultiMeshInstance3D in [towers, heads, rotors]:
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.use_colors = false
		mm.use_custom_data = true
		mm.mesh = meshes[mms.size()]
		mm.instance_count = n
		node.multimesh = mm
		node.material_override = _rotor_material if node == rotors else _tower_material
		mms.append(mm)
	var rollover: float = ProjectSettings.get_setting("rendering/limits/time/time_rollover_secs", 3600.0)
	for idx in n:
		var placed := turbine_placement(_heights, list[idx], idx, rollover)
		for m in 3:
			mms[m].set_instance_transform(idx, placed.transforms[m])
			mms[m].set_instance_custom_data(idx, placed.custom[m])

## Where and how big turbine `idx` (row `t` of HorizonData.TURBINES) is drawn:
## `transforms` and `custom` (INSTANCE_CUSTOM) for its tower, nacelle and rotor,
## in that order, plus its `scale`. Pure, so the tests can check it without a
## renderer (a MultiMesh reads back identity transforms headless).
static func turbine_placement(heights: PackedFloat32Array, t: Array, idx: int, rollover: float) -> Dictionary:
	# Rotors face into the wind: local +z points toward WIND_FROM_BEARING.
	var into_wind := HorizonMath.polar_point(WIND_FROM_BEARING, 1.0)
	var facing := Basis.looking_at(-Vector3(into_wind.x, 0.0, into_wind.y), Vector3.UP)
	var base := turbine_base(heights, t)
	var s: float = base.scale
	var hub: float = t[2] * s
	var blade: float = t[3] * 0.5 * s
	var min_width: float = base.distance * MIN_WIDTH_PER_METRE
	var tower_width := maxf(4.0 * s, min_width)
	var head_scale := HorizonMath.nacelle_scale(t[3], s, min_width)
	var foot: Vector3 = base.position - Vector3(0, TOWER_SINK * s, 0)
	var top: Vector3 = base.position + Vector3(0, hub, 0)
	var beacon := 1.0 if _hash(idx * 13 + 7) < BEACON_SHARE else 0.0
	var speed := 0.0 if _hash(idx * 17 + 3) < IDLE_SHARE else HorizonMath.loop_safe_speed(HorizonMath.rotor_speed(t[3]), rollover)
	# Towers and nacelles don't spin; their x is how much the warning light is
	# enlarged beyond the nacelle so it still shows from far away.
	var head_custom := Color(HorizonMath.beacon_boost(head_scale, min_width), 0.0, beacon, 0.0)
	var rotor_custom := Color(_hash(idx * 29 + 1) * TAU, speed, beacon, maxf(3.5 * s, min_width) / blade)
	return {
		"scale": s,
		"transforms": [
			Transform3D(facing * Basis.from_scale(Vector3(tower_width, hub + TOWER_SINK * s, tower_width)), foot),
			Transform3D(facing * Basis.from_scale(Vector3.ONE * head_scale), top),
			# The rotor sits in front of the nacelle (its local +z, into the wind).
			Transform3D(facing * Basis.from_scale(Vector3.ONE * blade), top + facing.z * 6.0 * head_scale),
		],
		"custom": [head_custom, head_custom, rotor_custom],
	}

## A unit tower: 1 m across at the foot, 0.6 m at the top, 1 m tall, foot at
## the origin. Instances scale it to width and height.
static func _tower_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_uv(Vector2.ZERO)
	var sides := 6
	for s in sides:
		var a0 := TAU * s / sides
		var a1 := TAU * (s + 1) / sides
		var b0 := Vector3(cos(a0) * 0.5, 0, sin(a0) * 0.5)
		var b1 := Vector3(cos(a1) * 0.5, 0, sin(a1) * 0.5)
		var t0 := Vector3(cos(a0) * 0.3, 1, sin(a0) * 0.3)
		var t1 := Vector3(cos(a1) * 0.3, 1, sin(a1) * 0.3)
		st.set_normal(Vector3(cos((a0 + a1) * 0.5), 0.15, sin((a0 + a1) * 0.5)).normalized())
		for v in [b0, t0, b1, b1, t0, t1]:
			st.add_vertex(v)
	return st.commit()

## Nacelle (sized for a 100 m rotor) with the warning light on its roof,
## marked by UV.x = 1 so the shader can find it (vertex colours aren't
## reliable on a MultiMesh in every renderer). Origin at the hub height.
static func _head_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	_box(st, Vector3(0, 0, -1.5), Vector3(4.0, 4.0, 11.0), 0.0)
	_box(st, BEACON_CENTER, Vector3(2.4, 2.4, 2.4), 1.0)
	return st.commit()

static func _box(st: SurfaceTool, center: Vector3, size: Vector3, marker: float) -> void:
	st.set_uv(Vector2(marker, 0.0))
	var h := size * 0.5
	var faces := [
		[Vector3.RIGHT, Vector3.UP, Vector3.BACK], [Vector3.LEFT, Vector3.UP, Vector3.FORWARD],
		[Vector3.UP, Vector3.BACK, Vector3.RIGHT], [Vector3.DOWN, Vector3.FORWARD, Vector3.RIGHT],
		[Vector3.BACK, Vector3.UP, Vector3.LEFT], [Vector3.FORWARD, Vector3.UP, Vector3.RIGHT],
	]
	for f in faces:
		var n: Vector3 = f[0]
		var u: Vector3 = f[1]
		var v: Vector3 = f[2]
		var c := center + n * h
		var du := u * h
		var dv := v * h
		st.set_normal(n)
		for p in [c - du - dv, c + du - dv, c + du + dv, c - du - dv, c + du + dv, c - du + dv]:
			st.add_vertex(p)

## Three blades as blade coordinates for wind_turbine.gdshader: UV.y 0..1 hub
## to tip, UV.x -0.5..0.5 across, UV2.x which blade (0, 1/3, 2/3). The
## positions are placeholders the shader replaces; they only need to span the
## rotor so nothing is culled.
static func _rotor_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_normal(Vector3.BACK)
	for blade in 3:
		var corners := [Vector2(-0.5, 0.0), Vector2(0.5, 0.0), Vector2(0.5, 1.0), Vector2(-0.5, 0.0), Vector2(0.5, 1.0), Vector2(-0.5, 1.0)]
		for c: Vector2 in corners:
			st.set_uv(c)
			st.set_uv2(Vector2(blade / 3.0, 0.0))
			st.add_vertex(Vector3(c.x, c.y, 0.0))
	return st.commit()
